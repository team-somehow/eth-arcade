# Chains to stream, comma-separated: arbitrum, base, or both.
TICK_CHAINS=arbitrum,base

# Substreams endpoints on The Graph Market. A new chain needs only an
# endpoint and a pool list, named TICK_ENDPOINT_<CHAIN> and TICK_POOLS_<CHAIN>.
TICK_ENDPOINT_ARBITRUM=arb-one.streamingfast.io:443
TICK_ENDPOINT_BASE=base-mainnet.streamingfast.io:443

# Pools to watch: 0xpool:decimals0:decimals1[:invert], comma-separated.
# ETH/stable pools: Uniswap v3 and Aerodrome Slipstream by address, Uniswap v4
# by 32-byte pool id. 0.3%-fee pools are left out; they trail the market by
# up to 0.3%, about $7, which is more than a box.
# Arbitrum: Uniswap v3 x4, then Uniswap v4 ETH/USDC and ETH/USDT.
TICK_POOLS_ARBITRUM=0xc6962004f452be9203591991d15f6b388e09e8d0:18:6,0x6f38e884725a116c9c7fbf208e79fe8828a2595f:18:6,0x641c00a822e8b671738d32a431a4fb6074e5c79d:18:6,0xc31e54c7a869b9fcbecc14363cf510d1c41fa443:18:6,0x864abca0a6202dba5b8868772308da953ff125b0f95015adbf89aaf579e903a8:18:6,0xe88bba0ec2fc9091d68344b32b504abcc59f0aa9e1ae2ef048b69bc7ec3f4df8:18:6
# Base: Uniswap v3 x2, then Aerodrome Slipstream x4 (WETH/USDC x3, WETH/USDT).
TICK_POOLS_BASE=0xd0b53d9277642d899df5c87a3966a349a798f224:18:6,0xb4cb800910b228ed3d0834cf79d697127bbb00e5:18:6,0xb2cc224c1c9fee385f8ad6a55b4d94e92359dc59:18:6,0x3fe04a59ebd38cf06080a6f60a98d124eb59392a:18:6,0x4e392fbfe4d0557c82d2f97f02ec39daa31516dd:18:6,0x9785ef59e2b499fb741674ecf6faf912df7b3c1b:18:6

# pools.py adds the ETH/USDC pools it finds in Messari's standardized DEX
# subgraphs to the lists above. Every one of them shares a schema, so it asks
# each the same question, and a protocol is added by its subgraph id alone.
# An API key from Subgraph Studio (thegraph.com/studio); only pools.py uses it.
GRAPH_API_KEY=
# Arbitrum: Uniswap V3, Sushiswap V3. Base: Uniswap V3.
TICK_SUBGRAPHS_ARBITRUM=FQ6JYszEKApsBpAmiHesRsd9Ygc6mzmpNRANeVQFYoVX,3oHCddbQGTi42kPZBwyGzD2JzZR33zK2MwXtxAerNJy2
TICK_SUBGRAPHS_BASE=FUbEPQw1oMghy39fwWBFY5fE6MXPXZQtjncQy2cXdrNS
# WETH, and the USDC it is paired with: native USDC, and on Arbitrum USDC.e too.
TICK_ETH_ARBITRUM=0x82af49447d8a07e3bd95bd0d56f35241523fbab1
TICK_USDC_ARBITRUM=0xaf88d065e77c8cc2239327c5edb3a432268e5831,0xff970a61a04b1ca14834a43f5de4533ebddb5cc8
TICK_ETH_BASE=0x4200000000000000000000000000000000000006
TICK_USDC_BASE=0x833589fcd6edb6e08f4c7c32d4f71b54bda02913
