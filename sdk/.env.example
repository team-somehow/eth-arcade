# Copy to .env next to your game. Anything set in the shell wins over this file.

# ---- prices --------------------------------------------------------------
# sim (default, no network) | coinbase | substreams | replay | frozen
TICK_MARKET_SOURCE=sim
# eth (default) | btc | sol | hbar
TICK_ASSET=eth
# Where substreams/relay.py is running, if you use that source.
SUBSTREAMS_BASE_URL=http://localhost:8787
# A recording, if you use TICK_MARKET_SOURCE=replay.
#TICK_REPLAY_FILE=eth.ndjson

# ---- money ---------------------------------------------------------------
# demo (paper money) | arc-testnet (real testnet USDC through TickEscrow)
TICK_FUNDING=demo
# Staked per press. 0.001 keeps real-funds testing cheap.
TICK_STAKE_USDC=10
# Kept from each deposit for gas, in USDC.
#TICK_GAS_FEE_USDC=0.01
#TICK_ARC_RPC=https://rpc.testnet.arc.io
#TICK_ESCROW_ADDRESS=0x4FA3D366A08aD06D60A0aB141FFb9981EDeE8627

# ---- names ---------------------------------------------------------------
#TICK_ENS_PARENT=tick.eth
#TICK_ENS_RPC=https://ethereum-sepolia-rpc.publicnode.com
#TICK_ENS_REGISTRY=0xD25ACD4eB42A40D8145E3A7F1feFB17D09649cAa
#TICK_ENS_RESOLVER=0xDBe98b10176aBf0BD2DFEE86fD3ee59A7630FAa8

# ---- device --------------------------------------------------------------
# auto turns the canvas onto a portrait panel; 0/90/180/270 force it.
TICK_ROTATE=auto
TICK_SOUND=1
# Round length, if the game does not fix it in code.
#TICK_WINDOW_S=10
