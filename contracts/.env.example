# Copy to .env (gitignored). Forge and smoke.sh read it.

# The PRIVATE KEY of the wallet that deploys, owns and funds the house:
# 0x followed by 64 hex characters. Not the 42-character address.
ARC_DEPLOYER_KEY=0x...

# USDC's ERC-20 interface on Arc testnet (6 decimals).
USDC=0x3600000000000000000000000000000000000000

# smoke.sh amounts, in 6-decimal units (1000000 = 1 USDC).
# House funding, sent only when the house is too small; the owner can withdraw it.
SEED_USDC=100000
# USDC locked in the test session.
SESSION_USDC=10000
