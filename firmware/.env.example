# Price feed for BOX RUN: sim (default), coinbase or substreams.
TICK_MARKET_SOURCE=sim

# Coin to price against USD: eth (default), btc, sol or hbar.
# substreams only prices eth; use sim or coinbase for the others.
TICK_ASSET=eth

# Where substreams/relay.py runs, for TICK_MARKET_SOURCE=substreams.
# Use the laptop's address on the same WiFi when running on the Pi.
SUBSTREAMS_BASE_URL=http://localhost:8787

