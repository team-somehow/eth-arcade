# Price feed for BOX RUN: sim (default), coinbase or substreams.
TICK_MARKET_SOURCE=sim

# Coin to price against USD: eth (default), btc, sol or hbar.
# substreams only prices eth; use sim or coinbase for the others.
TICK_ASSET=eth

# Money: demo (paper USDC minted on the device, the default) or arc-testnet
# (real Arc testnet USDC: send it to the device's QR code, play, and cash out
# back to the wallet it came from). arc-testnet is BOX RUN only.
TICK_FUNDING=demo

# USDC per press of A in BOX RUN, and per ride in RUSH. Leave it out for 10;
# use a tiny stake such as 0.001 when playing with real funds. Six decimals at most.
TICK_STAKE_USDC=0.5

# arc-testnet only: USDC the device keeps from each deposit to pay its own gas
# (0.01 by default), and overrides for the RPC and the TickEscrow contract.
# TICK_GAS_FEE_USDC=0.01
# TICK_ARC_RPC=https://rpc.testnet.arc.io
# TICK_ESCROW_ADDRESS=0x...

# arc-testnet only: the device shows each player's tick.eth name (ENS on
# Sepolia) once ens/scorekeeper.py has named their wallet. Override the RPC here.
# TICK_ENS_RPC=https://ethereum-sepolia-rpc.publicnode.com

# Where substreams/relay.py runs, for TICK_MARKET_SOURCE=substreams.
# Use the laptop's address on the same WiFi when running on the Pi.
SUBSTREAMS_BASE_URL=http://localhost:8787
